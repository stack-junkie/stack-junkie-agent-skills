{
  "name": "repo-readiness",
  "version": "1.2.0",
  "private": true,
  "description": "Solo-developer repository rules and local enforcement for agent-led work.",
  "scripts": {
    "policy:audit": "scripts/run_python.cmd scripts/repo_policy.py audit --repo .",
    "policy:verify": "scripts/run_python.cmd scripts/repo_policy.py verify --repo .",
    "policy:health": "scripts/run_python.cmd scripts/repo_policy.py repo-health --repo .",
    "scan-secrets": "scripts/run_python.cmd scripts/repo_policy.py scan-secrets --repo . --scope tracked",
    "prepare-release": "scripts/run_python.cmd scripts/repo_policy.py prepare-release --repo .",
    "install-skill": "scripts/install_skill.cmd"
  }
}
